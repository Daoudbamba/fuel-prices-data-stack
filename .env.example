# Copier en .env puis remplir les valeurs marquées OBLIGATOIRE.
# Le fichier .env est ignoré par Git : ne jamais y committer de vraies valeurs.
# Pour générer les secrets d'un coup : bash scripts/generer_env.sh

# --- Ports exposés sur la machine (127.0.0.1 uniquement) ----------------------
# 8080 et 8081 sont pris par le pipeline temps réel, 3000 et 3001 par d'autres projets.
AIRFLOW_HOST_PORT=8082
METABASE_HOST_PORT=3002
POSTGRES_HOST_PORT=5433

# --- PostgreSQL : superutilisateur de l'instance --------------------------------
POSTGRES_USER=postgres
# OBLIGATOIRE
POSTGRES_PASSWORD=

# --- Base de métadonnées d'Airflow ----------------------------------------------
AIRFLOW_DB_USER=airflow
# OBLIGATOIRE
AIRFLOW_DB_PASSWORD=

# --- Entrepôt : écrit par l'ingestion et par dbt ---------------------------------
ENTREPOT_DB=entrepot
ENTREPOT_USER=entrepot
# OBLIGATOIRE
ENTREPOT_PASSWORD=

# --- Lecture seule sur l'entrepôt : compte utilisé par Metabase ------------------
LECTEUR_USER=lecteur
# OBLIGATOIRE
LECTEUR_PASSWORD=

# --- Base applicative de Metabase (questions, tableaux de bord) ------------------
METABASE_DB_USER=metabase
# OBLIGATOIRE
METABASE_DB_PASSWORD=

# --- Airflow ---------------------------------------------------------------------
AIRFLOW_UID=1000
# OBLIGATOIRE : python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
AIRFLOW_FERNET_KEY=
# OBLIGATOIRE : python -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW_JWT_SECRET=

# --- Source de données -----------------------------------------------------------
# Flux officiel prix-carburants.gouv.fr : un fichier par jour, environ un mois d'historique.
SOURCE_URL_JOUR=https://donnees.roulez-eco.fr/opendata/jour
# Enseignes des stations : API Overpass d'OpenStreetMap (données sous licence ODbL).
OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Garde-fou mémoire (scripts/verifier_memoire.sh) -----------------------------
# Mémoire disponible minimale dans la VM Docker avant de lancer la stack, en Mo.
MEMOIRE_MIN_DISPONIBLE_MO=3000
